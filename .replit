modules = ["python-3.11", "web", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
ADMIN_EMAIL = "abedaphna@sricanhelp.com"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m uvicorn app.main:create_app --factory --host 0.0.0.0 --port 5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "scheduled"
run = ["python3", "-m", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "5000"]


[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
