# === PHI HARD CONSTRAINT ===
# Valant exports contain PHI. Nothing at patient grain may ever be committed.
# data/raw/ is where raw exports land locally; it must NEVER be tracked.
data/raw/*
!data/raw/.gitkeep

# Any stray raw-export patterns, defense in depth
data/**/*.csv
data/**/*.xlsx
data/**/*.xls
!tests/fixtures/**

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Scratch / local
*.log
.DS_Store
