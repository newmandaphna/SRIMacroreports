# === PHI AND SECRETS: nothing below may ever be committed ===

# Secrets
.env
.env.*
!.env.example
*service-account*.json
*credentials*.json
*.pem
*.key

# The database holds PHI, encrypted or not.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Raw exports from Valant or Google Sheets. These carry DOB, email, and phone.
*.xlsx
*.xls
*.csv
!tests/fixtures/*_SYNTHETIC.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local
*.log
.DS_Store
.idea/
.vscode/

# === Vendored agent skill bundles: not our code ===
# Installed by the agent harness and pinned by skills-lock.json (which stays
# tracked). The bundle is reproducible from its lock entry, and tracking it put
# 2,800 lines of third-party code through our lint gate. See AGENTS.md.
.agents/
