# Copy to .env for local development. NEVER commit a filled in copy, and never put a
# real value in this example file. In Replit these go in Secrets, not in a file.

ENVIRONMENT=development
DEBUG=false

# Required. The app refuses to start without these two.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
# Losing this key means losing the database. Escrow it separately from your backups.
DATABASE_ENCRYPTION_KEY=

DATABASE_PATH=data/sri_dashboard.db

# Google service account JSON, as one line. See README for how to create it.
# Required before any sync can run. Absent is tolerated at boot in development.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Seed admin, used once. Password change is forced on first login.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Defaults for the config table, editable by an admin in the UI once Phase 1 lands.
SESSION_TIMEOUT_MINUTES=15
SESSION_WARNING_MINUTES=13
BENEFITS_SESSION_THRESHOLD=25
# Base CPT codes that do not count as a session. These rows are still imported and
# their money still counts toward revenue. See ASSUMPTIONS.md A-030 and A-031.
CPT_EXCLUSIONS=99998,99999,QBCHK,FORM,PRO BONO
WEEK_START_DAY=monday
APP_TIMEZONE=America/New_York

# Feature flags
FEATURE_ROOM_UTILIZATION=false
FEATURE_PATIENT_FUNNEL=false
